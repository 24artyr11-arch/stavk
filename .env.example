# Telegram bot token from BotFather
BOT_TOKEN=

# OpenAI API key and vision-capable model
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# SQLite path (override to /app/data/bot.sqlite3 in Bothost settings)
DB_PATH=./data/bot.sqlite3
PORT=3000
# Set this to the public HTTPS domain configured in Bothost, e.g. https://myapp.bothost.ru
WEBAPP_URL=

# Telegram private channel ID where affiliate postbacks arrive (usually starts with -100)
POSTBACK_CHANNEL_ID=

# Comma-separated Telegram numeric user IDs allowed to use admin commands
ADMIN_IDS=

# Optional metadata
BOT_NAME=AI анализ купонов
DAILY_ANALYSIS_LIMIT=3

